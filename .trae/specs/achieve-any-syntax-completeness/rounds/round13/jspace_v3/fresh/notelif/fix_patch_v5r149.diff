+                    _v149_jt = self.cfg.get_block_by_offset(_v149_li.argval)
+                    if 'FALSE' in _v149_li.opname:
+                        _v149_false_start = _v149_jt
+                    else:
+                        _v149_false_start = _v149_ft_succ
+                    _v149_on_false = False
+                    _v149_cur = _v149_false_start
+                    _v149_steps = 0
+                    while _v149_cur is not None and _v149_steps < 4:
+                        if _v149_cur is _v149_then_entry:
+                            _v149_on_false = True
+                            break
+                        _v149_succs = list(_v149_cur.successors)
+                        if len(_v149_succs) != 1:
+                            break
+                        _v149_cur = _v149_succs[0]
+                        _v149_steps += 1
+                    if _v149_on_false and _v149_then_entry is not _v149_ft_succ:
+                        return None
             _fe_last = first_else.get_last_instruction()
