+                _v149_li = first_else.get_last_instruction()
+                if (_v149_li is not None and _v149_li.argval is not None
+                        and _v149_li.opname in (FORWARD_CONDITIONAL_JUMP_OPS | SHORT_CIRCUIT_JUMP_OPS)):
+                    _v149_ft_succ = next(
+                        (s for s in first_else.conditional_successors
