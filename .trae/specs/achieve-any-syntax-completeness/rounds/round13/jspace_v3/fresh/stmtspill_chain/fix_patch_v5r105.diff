+                elif not _cands and _tgt2 is not None:
+                    _nxt = _tgt2
+            else:
+                _succs = [s for s in _cur.successors
+                          if s not in set(getattr(_cur, 'exception_successors', None) or ())]
+                if len(_succs) == 1:
+                    _nxt = _succs[0]
+            if _nxt is None:
+                break
+            _walk.append((_cur, None))
+            _cur = _nxt
