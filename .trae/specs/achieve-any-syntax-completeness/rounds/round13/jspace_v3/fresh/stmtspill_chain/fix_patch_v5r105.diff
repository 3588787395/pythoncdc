+            return False
+        # ⑤ 窗口 = merge 块指令（含短路跳转，keep-or-pop 折叠所需）+ 中途块
+        # 指令 + 完成块 STORE 前指令。
+        _window = []
+        for _wb, _wsi in _walk:
+            _wcn = [i for i in _wb.instructions
+                    if i.opname not in ('RESUME', 'NOP', 'CACHE', 'PUSH_NULL')]
