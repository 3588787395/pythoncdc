+        op_chain 链首块；[C2] 链 2 黑箱折叠为 BoolOp、下游区域经派发登记；
+        [C3] 六重守卫任一不满足即逐位退回既有兜底，行为封闭。
+        """
+        _STORE_TYPES = ('STORE_FAST', 'STORE_NAME', 'STORE_GLOBAL', 'STORE_DEREF')
+        _v105_ban = ('STORE_', 'POP_TOP', 'RETURN_', 'RAISE', 'RERAISE',
