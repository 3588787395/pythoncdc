+        # 嵌套 or 组：'or' 标注段（TRUE 极性 → 同一真出口 T）+ 末位成员
+        # （FALSE 极性 → merge，其 fall-through 即 T——嵌套 or 的末位操作数）
+        or_blocks = [op_chain[i][0] for i in range(n - 1 - q, n)]
+        for b in or_blocks[:-1]:
+            li = b.get_last_instruction()
+            if (li is None or li.argval != true_exit
+                    or li.opname not in STRIP_JUMP_OPS
+                    or 'TRUE' not in li.opname):
+                return None
+        # 重建：and([...and 操作数..., Or([...or 操作数...])])
+        and_operands: List[Dict[str, Any]] = []
+        for b in and_blocks:
+            expr = self._reconstruct_boolop_operand(b, region)
+            if expr is None:
+                return None
+            and_operands.append(expr)
+        or_operands: List[Dict[str, Any]] = []
+        for b in or_blocks:
+            expr = self._reconstruct_boolop_operand(b, region)
+            if expr is None:
+                return None
+            or_operands.append(expr)
+        or_expr = (or_operands[0] if len(or_operands) == 1
+                   else {'type': 'BoolOp', 'op': 'or', 'values': or_operands})
+        and_values = and_operands + [or_expr]
+        return {'type': 'BoolOp', 'op': 'and', 'values': and_values}
+
